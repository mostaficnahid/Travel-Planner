# ─────────────────────────────────────────────────────────────────────────────
# Travel Planner — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env or .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE (PostgreSQL) ─────────────────────────────────────────────────────
# Get a free PostgreSQL database from: https://neon.tech  (recommended)
# Or: Supabase (supabase.com), Railway (railway.app)
#
# Neon provides TWO connection strings:
#   - DATABASE_URL  → pooled connection  (use for Prisma queries)
#   - DIRECT_URL    → direct connection  (use for Prisma migrations)
#
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ── NEXTAUTH ──────────────────────────────────────────────────────────────────
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-strong-random-secret-here"

# Set this to your production URL on Vercel, e.g.:
# NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_URL="http://localhost:3000"

# ── AI PROVIDER ───────────────────────────────────────────────────────────────
# Google Gemini API key (get from https://aistudio.google.com/)
# If not set, the system uses the deterministic 196-country fallback (no AI).
GEMINI_API_KEY=""

# ── OAUTH PROVIDERS (Optional) ────────────────────────────────────────────────
# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth — https://developers.facebook.com/
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
